#include <iostream>
#include <string>
using namespace std;
class Dispositivo {
public:
    virtual ~Dispositivo() = default;
    virtual void encender() = 0;
    virtual void apagar() = 0;
    virtual string estado() const = 0;
};
class Televisor : public Dispositivo {
private:
    bool encendido;
    int volumen;
    int canal;
    void sintonizarSenal() const;
public:
    Televisor();
    void encender() override;
    void apagar() override;
    string estado() const override;
    bool cambiarVolumen(int nuevoVolumen);
    bool cambiarCanal(int nuevoCanal);
    int obtenerVolumen() const;
    int obtenerCanal() const;
};
Televisor::Televisor() : encendido(false), volumen(10), canal(1) {}


void Televisor::sintonizarSenal() const {
    cout << "  (sintonizando senal del canal " << canal << ")\n";
}
void Televisor::encender() {
    encendido = true;
    sintonizarSenal();
}
void Televisor::apagar() {
    encendido = false;
}
string Televisor::estado() const {
    if (!encendido) return "Televisor apagado";
    return "Televisor encendido | Canal " + to_string(canal) + " | Volumen " + to_string(volumen);
}
bool Televisor::cambiarVolumen(int nuevoVolumen) {
    if (!encendido || nuevoVolumen < 0 || nuevoVolumen > 100) return false;
    volumen = nuevoVolumen;
    return true;
}
bool Televisor::cambiarCanal(int nuevoCanal) {
    if (!encendido || nuevoCanal < 1 || nuevoCanal > 500) return false;
    canal = nuevoCanal;
    sintonizarSenal();
    return true;
}


int Televisor::obtenerVolumen() const {
    return volumen;
}


int Televisor::obtenerCanal() const {
    return canal;
}
void probarDispositivo(Dispositivo& dispositivo) {
    cout << dispositivo.estado() << "\n";
    dispositivo.encender();
    cout << dispositivo.estado() << "\n";
    dispositivo.apagar();
    cout << dispositivo.estado() << "\n";
}
int main() {
    Televisor tv;
    cout << "=== ENCAPSULAMIENTO ===\n";
    cout << "Volumen con TV apagado: " << (tv.cambiarVolumen(30) ? "aceptado" : "rechazado") << "\n";
    tv.encender();
    cout << "Volumen 30: " << (tv.cambiarVolumen(30) ? "aceptado" : "rechazado") << "\n";
    cout << "Volumen 250: " << (tv.cambiarVolumen(250) ? "aceptado" : "rechazado") << "\n";
    cout << "Canal 0: " << (tv.cambiarCanal(0) ? "aceptado" : "rechazado") << "\n";
    cout << "Canal 7:\n";
    bool cambioCanal = tv.cambiarCanal(7);
    cout << "  " << (cambioCanal ? "aceptado" : "rechazado") << "\n";
    cout << tv.estado() << "\n";
    tv.apagar();
    cout << "\n=== ABSTRACCION ===\n";
    probarDispositivo(tv);
    return 0;
}
